# ==============================================================================
# Argus AI — Environment Configuration Template
# ==============================================================================

# Core Microservice URLs
BACKEND_PORT=8000
FRONTEND_PORT=5173
DIGITAL_TWIN_URL=http://localhost:7001
ATTACK_ENGINE_URL=http://localhost:7002
CHATBOT_URL=http://localhost:7003

# Run Mode: Set to 'true' to run backend standalone without live microservices.
# Set to 'false' to communicate with live Neo4j, Attack Engine, and Chatbot.
MOCK_SERVICES=true

# Security & JWT Secrets
JWT_SECRET_KEY=argus-secret-token-key-replace-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Neo4j Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=arguspassword123
NEO4J_DATABASE=neo4j

# LLM Provider API Keys for Attack Engine (Optional: only needed if testing against live providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Chatbot Target Defense Level (0=Unfiltered/Vulnerable, 1=Basic Guard, 2=Strict Canary)
DEFENSE_LEVEL=0
